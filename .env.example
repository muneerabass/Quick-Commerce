## Expo app config

# API base URL. Override per device:
#   - iOS simulator:          http://localhost:3000/api/v1
#   - Android emulator:       http://10.0.2.2:3000/api/v1
#   - Real phone on LAN:      http://<laptop LAN IP>:3000/api/v1
# Leave unset to use the Platform default (localhost on iOS, 10.0.2.2 on Android).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Maps SDK key for the native map picker.
# Restrict this key to the Android package/iOS bundle ID and the correct
# development or production signing certificate in Google Cloud.
# Required for Android (Maps SDK for Android). iOS falls back to Apple Maps if unset.
# NOTE: this is injected by the react-native-maps config plugin (app.config.js),
# so after setting it you must REBUILD the native app (npx expo run:android /
# run:ios) — a JS reload is not enough. The delivery "Navigate" button opens the
# external Google Maps app via a link and works without this key.
GOOGLE_MAPS_API_KEY=
